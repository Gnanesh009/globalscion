# Django REST API root, e.g. https://api.globalscion.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Serve every request from the in-repo mock adapter (Django-shaped payloads).
# Flip to false once the backend is reachable — no component changes required.
VITE_USE_MOCK=true

# Absolute origin used for canonical URLs / Open Graph tags
VITE_SITE_URL=https://globalscion.com
